# -----------------------------------------------------------------------------
# Entorno gráfico: XFCE sobre Xorg
# Meta de RAM en reposo: <= 600 MB. Si se supera, evalúa cambiar a LXQt.
# -----------------------------------------------------------------------------

# Servidor gráfico
xorg
x11-xserver-utils
dbus-x11
dbus-user-session

# Escritorio XFCE (núcleo, sin xfce4-goodies para ahorrar RAM y disco)
xfce4
xfce4-terminal
xfce4-notifyd
xfce4-power-manager
xfce4-pulseaudio-plugin
xfce4-screenshooter
xfce4-taskmanager
xfce4-screensaver
thunar
thunar-archive-plugin

# Arranque gráfico (pantalla de carga con la marca de PolarisOS)
plymouth
plymouth-themes

# Inicio de sesión
lightdm
lightdm-gtk-greeter

# Permisos gráficos (necesario para Synaptic e instalador)
polkitd
pkexec
mate-polkit

# Audio moderno y ligero
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol

# Red (applet en el panel)
network-manager-gnome

# Apariencia
greybird-gtk-theme
papirus-icon-theme
fonts-dejavu
fonts-liberation2
fonts-noto-color-emoji
